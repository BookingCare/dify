server {
    listen ${PORT};
    server_name _;

    resolver 8.8.8.8 1.1.1.1 valid=300s;
    resolver_timeout 5s;

    client_max_body_size 50m;
    absolute_redirect off;

    # Static assets for branding
    location = /logo_bookingcare.svg {
        root /usr/share/nginx/html;
        access_log off;
        add_header Content-Type image/svg+xml;
    }

    location = /logo_bookingcare.png {
        root /usr/share/nginx/html;
        access_log off;
        add_header Content-Type image/png;
    }

    location = /favicon.ico {
        root /usr/share/nginx/html;
        access_log off;
    }

    # Root redirect to the Dify Cloud chat app
    location = / {
        return 302 /chat/88bzHBhVwM7eR49V;
    }

    # Reverse proxy to Dify Cloud (udify.app)
    location / {
        proxy_pass https://udify.app;
        proxy_set_header Host udify.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
        proxy_ssl_name udify.app;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;

        # Disable compression so sub_filter can modify HTML
        proxy_set_header Accept-Encoding "";

        # Header buffers for large Cloudflare/Dify headers (e.g. CSP)
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;

        # Strip upstream security headers
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Frame-Options;

        # Streaming support for real-time SSE
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        # Apply branding injections (text/html is always included by default)
        sub_filter_types text/javascript application/javascript application/json;
        include /etc/nginx/conf.d/an_avatar.conf;
    }
}
